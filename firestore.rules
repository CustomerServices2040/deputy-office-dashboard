rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Default is deliberately closed. Replace ONLY this placeholder with the
  // dedicated office user's UID, after creating that user in Firebase Auth.
  function isOffice(){return request.auth != null && request.auth.uid == 'REPLACE_WITH_OFFICE_UID';}
  function validTopic(){let d=request.resource.data;return d.keys().hasAll(['kind','number','title','directions','employee','received','directorate','status','version','updatedAt','updatedBy'])
   && d.keys().hasOnly(['kind','number','title','directions','employee','received','directorate','status','version','updatedAt','updatedBy'])
   && d.kind in ['mersal','email'] && d.status in ['open','completed']
   && d.title is string && d.title.size()>0 && d.title.size()<=500
   && d.directions is string && d.directions.size()>0 && d.directions.size()<=5000
   && d.employee is string && d.employee.size()>0 && d.employee.size()<=200
   && d.number is string && d.number.size()<=120
   && d.received is string && d.received.size()<=10
   && d.directorate is string && d.directorate.size()<=300
   && d.updatedBy is string && d.updatedBy.size()>0 && d.updatedBy.size()<=120
   && d.updatedAt is string && d.updatedAt.size()<=30
   && d.version is int && d.version>0
   && (d.kind=='email'||(d.number.size()>0 && d.directorate.size()>0 && d.received.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));}
  match /officeTopics/{topicId} {
   allow read: if isOffice();
   allow create: if isOffice() && validTopic() && request.resource.data.version==1;
   allow update: if isOffice() && validTopic() && request.resource.data.kind==resource.data.kind && request.resource.data.version==resource.data.version+1;
   allow delete: if false;
  }
  match /{document=**}{allow read,write:if false;}
 }
}
